{
  "name": "tao-tools",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "ingest:kraken": "pnpm --filter @tao-tools/ingest run kraken:phase0",
    "ingest:backfill-prices": "pnpm --filter @tao-tools/ingest run backfill-prices",
    "spike-g": "pnpm --filter @tao-tools/ingest run spike-g",
    "pipeline:materialize": "pnpm --filter @tao-tools/pipeline run materialize",
    "pipeline:export": "pnpm --filter @tao-tools/pipeline run export",
    "pipeline:cross-rate-check": "pnpm --filter @tao-tools/pipeline run cross-rate-check",
    "web:dev": "pnpm --filter @tao-tools/web run dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
