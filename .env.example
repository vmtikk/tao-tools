# Copy to .env and fill in when moving off the local stand-in.
#
# BRONZE_URI selects where the bronze writer COPYs Parquet to. Leave unset (or
# point it at a local path) to develop without any cloud credentials — DuckDB
# COPY works identically against a local path or an s3:// URI, so switching to
# R2 later is a config change, not a code change.
#
# Local (default, no credentials needed):
BRONZE_URI=./data/bronze
# R2 (uncomment and fill in to write real bronze to Cloudflare R2):
# BRONZE_URI=s3://tao-bronze
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Blockmachine (needed for Spike G and all of Phase 2+, not Phase 0/1)
# BLOCKMACHINE_API_KEY=
